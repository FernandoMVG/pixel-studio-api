# Puerto de la API (1024–65535)
PIXEL_PORT=4317
# Carpeta donde se guardan los proyectos .json
# PIXEL_PROJECTS_DIR=C:\Users\tu-usuario\PixelStudio\proyectos
# Archivo de ajustes que guarda la app (permisos del agente)
# PIXEL_SETTINGS_FILE=C:\Users\tu-usuario\PixelStudio\ajustes.json
# Permisos iniciales del agente MCP (true/false); se usan hasta que los cambies desde la app
PIXEL_AGENT_CAN_CREATE=true
PIXEL_AGENT_CAN_DELETE=false
